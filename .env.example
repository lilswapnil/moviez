# Moviez - Single .env at project root (used by frontend and backend)
# Copy to .env and fill in your values

# TMDB API - get your key from https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key

# Backend URL - rewrites proxy /api/v1/* to this (keep TMDB key server-side)
# Local: 8000 when backend runs via uvicorn; 8001 when backend runs in Docker (port mapping)
BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# --- Vercel deployment: set these in Vercel Project Settings → Environment Variables ---
# BACKEND_URL=https://your-backend.railway.app   # deployed backend (Railway, Render, etc.)
# NEXT_PUBLIC_BACKEND_URL=https://your-backend.railway.app  # same; client rewrites need this
# TMDB_API_KEY=...  # required; backend needs it for TMDB calls

# Optional: TMDB Bearer token (alternative to api_key)
# TMDB_BEARER_TOKEN=

# Optional: for ML/recommendations
# KAGGLE_API_TOKEN=
# OPENAI_API_KEY=
# HUGGINGFACEHUB_TOKEN=

# Optional: auth/database (if used)
# DATABASE_URL=postgresql://user:pass@localhost/moviez
# JWT_SECRET=your_jwt_secret
