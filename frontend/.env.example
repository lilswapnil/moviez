# Backend API URL - all TMDB calls go through the backend (API key stays secure server-side)
# Required: set this when backend runs separately (e.g. local dev, production)
BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# For Vercel: VERCEL_URL is auto-set. For local dev, server uses http://localhost:3000.
# Override with NEXT_PUBLIC_APP_URL if your app runs elsewhere (e.g. http://localhost:4000).
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# TMDB_API_KEY - required for Next.js API routes when deployed without external backend (e.g. Vercel)
