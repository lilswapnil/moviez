# TMDB images are public, no key needed
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# TMDB API authentication (use one; Bearer token preferred on Vercel)
# TMDB_BEARER_TOKEN=eyJhbGciOiJIUzI1NiJ9...
# TMDB_API_KEY=your_api_key

# Backend API URL (for Next.js rewrites when proxying to backend)
# Default: http://localhost:8000
BACKEND_URL=http://localhost:8000
