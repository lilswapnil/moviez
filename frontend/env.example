# TMDB API key - required for Vercel (Next.js API routes call TMDB directly)
# Get one free at https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_api_key

# Backend URL - optional. When set, rewrites proxy /api/v1/* to external backend.
# When unset (e.g. Vercel-only), Next.js API routes call TMDB directly.
# BACKEND_URL=http://localhost:8000
