# TMDB API - get your key from https://www.themoviedb.org/settings/api
# Required for all movie/TV data - keep this key in backend only, never expose to frontend
TMDB_API_KEY=your_tmdb_api_key

# Optional: TMDB also supports Bearer token auth (alternative to api_key)
# TMDB_BEARER_TOKEN=

# Optional: for ML/recommendations (if used)
# KAGGLE_API_TOKEN=
# OPENAI_API_KEY=
# HUGGINGFACEHUB_TOKEN=
